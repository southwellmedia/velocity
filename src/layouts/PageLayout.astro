---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/layout/Header.astro';
import Footer from '@/components/layout/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  /** Include this page in the Pagefind site search index (default: true) */
  searchable?: boolean;
}

const { title, description, image, imageAlt, noindex, nofollow, searchable = true } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
>
  <Header
    slot="header"
    position="fixed"
    size="lg"
    showActiveState
    showCta
  />

  <!-- BaseLayout already renders <main>; this wrapper only offsets the fixed header -->
  <div class="min-h-screen pt-16" data-pagefind-body={searchable ? '' : undefined}>
    <slot />
  </div>

  <Footer slot="footer" layout="simple" />
</BaseLayout>
