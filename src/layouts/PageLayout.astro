---
/**
 * PageLayout
 * Layout wrapper for standard content pages (non-landing)
 * Uses Header + Footer with content page configuration
 */
import BaseLayout from './BaseLayout.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import SiteFooter from '@/components/site/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  nofollow?: boolean;
  /** Include this page in the Pagefind site search index (default: true) */
  searchable?: boolean;
}

const { title, description, image, imageAlt, noindex, nofollow, searchable = true } = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  image={image}
  imageAlt={imageAlt}
  noindex={noindex}
  nofollow={nofollow}
>
  <SiteHeader slot="header" />

  <!-- BaseLayout already renders <main>; this wrapper only offsets the fixed header -->
  <div class="min-h-screen pt-(--header-offset)" data-pagefind-body={searchable ? '' : undefined}>
    <slot />
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>
