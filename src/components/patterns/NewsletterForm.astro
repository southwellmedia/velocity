---
import Input from '@/components/ui/form/Input/Input.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { cn } from '@/lib/cn';
import { actions } from 'astro:actions';
import { getLocale, useTranslations } from '@/i18n';

interface Props {
  /** External endpoint. Defaults to the `newsletter` Astro Action. */
  action?: string;
  placeholder?: string;
  buttonText?: string;
  successMessage?: string;
  class?: string;
}

const t = useTranslations(getLocale(Astro));

const {
  action,
  placeholder = t('form.emailPlaceholder'),
  buttonText = t('form.subscribe'),
  successMessage = t('form.subscribed'),
  class: className,
} = Astro.props;

const messages = JSON.stringify({
  success: successMessage,
  sending: t('form.subscribing'),
  failed: t('form.subscribeFailed'),
  generic: t('form.genericError'),
  invalidEmail: t('form.errors.invalidEmail'),
});
---

<form
  class={cn('newsletter-form', className)}
  action={action ?? actions.newsletter}
  method="POST"
  data-endpoint={action}
  data-messages={messages}
>
  <div class="flex flex-col sm:flex-row gap-3">
    <div class="flex-1">
      <Input
        name="email"
        type="email"
        placeholder={placeholder}
        aria-label={t('form.emailAddress')}
        required
        autocomplete="email"
      />
    </div>
    <Button type="submit" class="newsletter-submit">
      {buttonText}
    </Button>
  </div>

  <!-- Honeypot field for spam protection -->
  <div class="hidden" aria-hidden="true">
    <input type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <p class="newsletter-message hidden mt-3 text-sm" role="status" aria-live="polite"></p>
</form>

<script>
  import { actions, isInputError } from 'astro:actions';

  type Messages = { success: string; sending: string; failed: string; generic: string; invalidEmail: string };

  function initNewsletterForms() {
    const forms = document.querySelectorAll('.newsletter-form') as NodeListOf<HTMLFormElement>;

    forms.forEach((form) => {
      const button = form.querySelector('.newsletter-submit') as HTMLButtonElement;
      const message = form.querySelector('.newsletter-message') as HTMLParagraphElement;

      if (!button || !message || form.dataset.init) return;
      form.dataset.init = 'true';

      const msg = JSON.parse(form.dataset.messages ?? '{}') as Messages;
      const originalText = button.textContent;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        button.disabled = true;
        button.textContent = msg.sending;
        message.classList.add('hidden');

        try {
          const formData = new FormData(form);
          let errorText: string | null = null;

          if (form.dataset.endpoint) {
            // Custom endpoint: expects JSON { success, error? }
            const response = await fetch(form.dataset.endpoint, { method: 'POST', body: formData });
            const data = await response.json();
            if (!data.success) errorText = data.error || msg.generic;
          } else {
            const { error } = await actions.newsletter(formData);
            if (error) {
              errorText = isInputError(error) ? msg.invalidEmail : msg.generic;
            }
          }

          if (!errorText) {
            message.textContent = msg.success;
            message.className = 'newsletter-message mt-3 text-sm text-success';
            form.reset();
          } else {
            message.textContent = errorText;
            message.className = 'newsletter-message mt-3 text-sm text-destructive';
          }
        } catch {
          message.textContent = msg.failed;
          message.className = 'newsletter-message mt-3 text-sm text-destructive';
        } finally {
          button.disabled = false;
          button.textContent = originalText;
          message.classList.remove('hidden');
        }
      });
    });
  }

  initNewsletterForms();
  document.addEventListener('astro:after-swap', initNewsletterForms);
</script>
