---
/**
 * Page section with standard spacing, width and an optional heading block.
 * A thin wrapper over blocks/Band, so it takes the same tone, width and pad.
 */
import Band from '@/components/blocks/Band.astro';
import type { BandPad, BandTone, BandWidth } from '@/components/blocks/band.variants';

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  /** secondary is tinted, invert is dark, brand is filled with the brand colour */
  tone?: BandTone;
  width?: BandWidth;
  pad?: BandPad;
  class?: string;
}

const { id, eyebrow, title, lead, tone = 'default', width, pad, class: className } = Astro.props;
---

<Band id={id} eyebrow={eyebrow} title={title} lead={lead} tone={tone} width={width} pad={pad} class={className}>
  <slot name="action" slot="action" />
  <slot />
</Band>
