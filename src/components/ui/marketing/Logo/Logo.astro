---
/**
 * Logo Component
 *
 * To customize: Replace the SVG files in src/assets/branding/
 * - logomark.svg       → Icon for light backgrounds
 * - logomark-dark.svg  → Icon for dark backgrounds
 * - logo-full.svg      → Full logo for light backgrounds
 * - logo-full-dark.svg → Full logo for dark backgrounds
 *
 * The files render inline, so they can use currentColor and CSS variables such as
 * var(--logo-accent) to follow the theme.
 */
import siteConfig from '@/config/site.config';

import logomark from '@/assets/branding/logomark.svg?raw';
import logomarkDark from '@/assets/branding/logomark-dark.svg?raw';
import logoFull from '@/assets/branding/logo-full.svg?raw';
import logoFullDark from '@/assets/branding/logo-full-dark.svg?raw';

interface Props {
  /** Size preset */
  size?: 'sm' | 'md' | 'lg' | 'xl' | '2xl';
  /** Force dark mode logo (for dark backgrounds) */
  forceDark?: boolean;
  /** Use full logo instead of logomark */
  variant?: 'logomark' | 'full';
  /** Hide from screen readers. Use when the site name is shown next to the logo. */
  decorative?: boolean;
  /** Additional CSS classes */
  class?: string;
}

const {
  size = 'md',
  forceDark = false,
  variant = 'logomark',
  decorative = false,
  class: className,
} = Astro.props;

const lightLogo = variant === 'full' ? logoFull : logomark;
const darkLogo = variant === 'full' ? logoFullDark : logomarkDark;

const sizeClasses: Record<string, string> = {
  sm: 'h-5 w-5',
  md: 'h-6 w-6',
  lg: 'h-8 w-8',
  xl: 'h-12 w-12',
  '2xl': 'h-24 w-24',
};

const sizeClass = sizeClasses[size] || sizeClasses.md;
const alt = decorative ? '' : siteConfig.branding.logo.alt;
---

<span class:list={['inline-block', className]} role={decorative ? undefined : 'img'} aria-label={alt || undefined} aria-hidden={decorative ? 'true' : undefined}>
  {forceDark ? (
    <span class:list={[sizeClass, 'block [&>svg]:size-full']} set:html={darkLogo} />
  ) : (
    <Fragment>
      <span class:list={[sizeClass, 'block dark:hidden [&>svg]:size-full']} set:html={lightLogo} />
      <span class:list={[sizeClass, 'hidden dark:block [&>svg]:size-full']} set:html={darkLogo} />
    </Fragment>
  )}
</span>
