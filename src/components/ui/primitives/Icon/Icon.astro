---
/**
 * Icon: any Lucide icon by its kebab-case name (https://lucide.dev/icons, aliases
 * included), as an inline SVG drawn at build time, so it ships no JavaScript.
 * A few brand marks Lucide doesn't include (github, twitter, linkedin and the
 * brand-* logos) live in brand-icons.ts.
 *
 *   <Icon name="calendar-check" size="sm" />
 *
 * An unknown name draws the `x` icon and logs a warning during the build.
 */
import type { IconName as LucideIconName } from 'lucide-react/dynamic';
import { icons as lucide } from 'lucide';
import { cn } from '@/lib/cn';
import { brandIcon, type BrandIconName } from './brand-icons';

export type IconName = LucideIconName | BrandIconName;

interface Props {
  /** A Lucide icon name, e.g. "map-pin", or a brand mark */
  name: IconName | (string & {});
  size?: 'xs' | 'sm' | 'md' | 'lg' | 'xl';
  class?: string;
  strokeWidth?: number;
}

const { name, size = 'md', class: className, strokeWidth = 2 } = Astro.props;

const sizes = {
  xs: 'w-3 h-3',
  sm: 'w-4 h-4',
  md: 'w-5 h-5',
  lg: 'w-6 h-6',
  xl: 'w-8 h-8',
};

const pascal = (kebab: string) =>
  kebab.replace(/(^|-)([a-z0-9])/g, (_, __, char: string) => char.toUpperCase());
const brand = brandIcon(name);
let node = brand ? undefined : lucide[pascal(name) as keyof typeof lucide];
if (!brand && !node) {
  console.warn(`[Icon] "${name}" is not a Lucide icon name (https://lucide.dev/icons); drawing "x" instead.`);
  node = lucide.X;
}
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill={brand?.filled ? 'currentColor' : 'none'}
  stroke={brand?.filled ? 'none' : 'currentColor'}
  stroke-width={brand?.filled ? 0 : strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  class={cn(sizes[size], 'shrink-0', className)}
  aria-hidden="true"
>
  {
    brand ? (
      <path d={brand.path} />
    ) : (
      node!.map(([Tag, attrs]) => <Tag {...attrs} />)
    )
  }
</svg>
