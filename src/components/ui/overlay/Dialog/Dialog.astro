---
/**
 * Dialog Component
 * A modal built on the native <dialog> element opened with showModal(), so the
 * browser handles focus containment, Escape, the back gesture, an inert page
 * and returning focus to the button that opened it. No focus-trap script.
 *
 * Open it from any button with data-dialog-open="<id>" (or from script with
 * window.openDialog(id) or the element's own showModal()). Buttons inside with
 * data-dialog-close close it, as do Escape and a click on the backdrop.
 *
 *   <Button data-dialog-open="delete-dialog">Delete</Button>
 *   <Dialog id="delete-dialog" title="Delete project?">…</Dialog>
 */
import { cn } from '@/lib/cn';
import { getLocale, useTranslations } from '@/i18n';
import Icon from '../../primitives/Icon/Icon.astro';

interface Props {
  id: string;
  title?: string;
  description?: string;
  /** Accessible name when there is no visible title */
  label?: string;
  size?: 'sm' | 'md' | 'lg' | 'xl';
  /** 'any': Escape and backdrop click close it (default). 'closerequest': Escape only. 'none': only your code closes it. */
  closedby?: 'any' | 'closerequest' | 'none';
  class?: string;
}

const { id, title, description, label, size = 'md', closedby = 'any', class: className } = Astro.props;
const t = useTranslations(getLocale(Astro));

const sizes = {
  sm: 'max-w-sm',
  md: 'max-w-lg',
  lg: 'max-w-2xl',
  xl: 'max-w-4xl',
};
---

<dialog
  id={id}
  class={cn(
    'velocity-dialog bg-background text-foreground border-border m-auto w-[calc(100%-2rem)] rounded-xl border p-0 shadow-xl',
    sizes[size],
    className
  )}
  closedby={closedby}
  aria-labelledby={title ? `${id}-title` : undefined}
  aria-label={!title ? label : undefined}
  aria-describedby={description ? `${id}-description` : undefined}
  data-dialog
>
  <!-- Close Button -->
  <button
    type="button"
    class={cn(
      'absolute top-4 right-4',
      'text-foreground-muted hover:text-foreground',
      'transition-colors',
      'focus-visible:ring-ring rounded-md focus-visible:ring-2 focus-visible:outline-none'
    )}
    data-dialog-close
    aria-label={t('a11y.close')}
  >
    <Icon name="x" class="h-5 w-5" />
  </button>

  <!-- Header -->
  {(title || description) && (
    <div class="p-6 pb-0">
      {title && (
        <h2 id={`${id}-title`} class="text-foreground m-0 pr-8 text-lg font-semibold">
          {title}
        </h2>
      )}
      {description && (
        <p id={`${id}-description`} class="text-foreground-muted mt-1 text-sm">
          {description}
        </p>
      )}
    </div>
  )}

  <!-- Content -->
  <div class="p-6">
    <slot />
  </div>

  <!-- Footer (optional) -->
  <slot name="footer" />
</dialog>

<style>
  .velocity-dialog {
    max-height: calc(100dvh - 2rem);
    /* Exit: fade and shrink, staying in the top layer until it finishes */
    opacity: 0;
    scale: 0.95;
    transition:
      opacity 200ms ease-out,
      scale 200ms ease-out,
      overlay 200ms ease-out allow-discrete,
      display 200ms ease-out allow-discrete;
  }
  .velocity-dialog[open] {
    opacity: 1;
    scale: 1;
  }
  @starting-style {
    .velocity-dialog[open] {
      opacity: 0;
      scale: 0.95;
    }
  }

  /* Keep scroll gestures from reaching the page behind the modal. */
  .velocity-dialog:modal {
    overscroll-behavior: contain;
  }
  .velocity-dialog::backdrop {
    overflow: hidden;
    overscroll-behavior: contain;
    background: color-mix(in oklch, var(--color-foreground) 50%, transparent);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition:
      opacity 200ms ease-out,
      overlay 200ms ease-out allow-discrete,
      display 200ms ease-out allow-discrete;
  }
  .velocity-dialog[open]::backdrop {
    opacity: 1;
  }
  @starting-style {
    .velocity-dialog[open]::backdrop {
      opacity: 0;
    }
  }
</style>

<script>
  type DialogWindow = Window & {
    openDialog?: (id: string) => void;
    closeDialog?: (id: string) => void;
  };
  const w = window as DialogWindow;

  function findDialog(id: string): HTMLDialogElement | null {
    const el = document.getElementById(id);
    return el instanceof HTMLDialogElement ? el : null;
  }

  // closedby="any" is not in Safari yet. Close on a press and release that
  // both land outside the panel, so a text selection dragged onto the
  // backdrop does not dismiss it.
  const supportsClosedBy = 'closedBy' in HTMLDialogElement.prototype;
  function outside(event: PointerEvent, dialog: HTMLDialogElement) {
    const r = dialog.getBoundingClientRect();
    return event.clientX < r.left || event.clientX > r.right || event.clientY < r.top || event.clientY > r.bottom;
  }

  function initDialogs() {
    if (!supportsClosedBy) {
      document.querySelectorAll<HTMLDialogElement>('dialog[data-dialog][closedby="any"]').forEach((dialog) => {
        if (dialog.dataset.dialogInit) return;
        dialog.dataset.dialogInit = 'true';
        let pressedOutside = false;
        dialog.addEventListener('pointerdown', (e) => {
          pressedOutside = outside(e, dialog);
        });
        dialog.addEventListener('pointerup', (e) => {
          if (pressedOutside && outside(e, dialog)) dialog.close();
        });
      });
    }

    if (document.documentElement.dataset.dialogsInit) return;
    document.documentElement.dataset.dialogsInit = 'true';

    document.addEventListener('click', (event) => {
      const target = event.target as Element;
      const opener = target.closest<HTMLElement>('[data-dialog-open]');
      if (opener) {
        findDialog(opener.dataset.dialogOpen ?? '')?.showModal();
        return;
      }
      const closer = target.closest<HTMLElement>('[data-dialog-close]');
      if (closer) {
        const dialog = closer.dataset.dialogClose ? findDialog(closer.dataset.dialogClose) : closer.closest('dialog');
        dialog?.close();
      }
    });

    w.openDialog = (id: string) => {
      const dialog = findDialog(id);
      if (dialog && !dialog.open) dialog.showModal();
    };
    w.closeDialog = (id: string) => findDialog(id)?.close();
  }

  initDialogs();
  document.addEventListener('astro:after-swap', initDialogs);
</script>
