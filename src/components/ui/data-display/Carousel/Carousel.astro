---
/**
 * A row of slides that scrolls sideways: images, cards, quotes. Built on CSS
 * scroll snap, so it swipes on touch screens and scrolls with a trackpad or the
 * keyboard. Previous / next buttons step one slide at a time and stop at the
 * ends, a marker per position jumps straight to it, and a hidden status line
 * announces the slide once scrolling settles.
 *
 * Every direct child of the default slot is a slide.
 *
 *   <Carousel label="Customer stories" perView={3}>
 *     <Card>…</Card><Card>…</Card><Card>…</Card><Card>…</Card>
 *   </Carousel>
 */
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { getLocale, useTranslations } from '@/i18n';
import { cn } from '@/lib/cn';

interface Props {
  /** Names the carousel for screen readers */
  label: string;
  /** Slides visible at once on wide screens (one on phones, two from sm when 2+) */
  perView?: 1 | 2 | 3 | 4;
  /** Hide the previous / next buttons (swipe and scroll still work) */
  hideControls?: boolean;
  class?: string;
}

const { label, perView = 1, hideControls = false, class: className } = Astro.props;
const t = useTranslations(getLocale(Astro));
const columns = {
  1: 'auto-cols-[100%]',
  2: 'auto-cols-[100%] sm:auto-cols-[calc((100%-1.5rem)/2)]',
  3: 'auto-cols-[100%] sm:auto-cols-[calc((100%-1.5rem)/2)] lg:auto-cols-[calc((100%-3rem)/3)]',
  4: 'auto-cols-[100%] sm:auto-cols-[calc((100%-1.5rem)/2)] lg:auto-cols-[calc((100%-4.5rem)/4)]',
};
const button =
  'border-border bg-background text-foreground hover:bg-secondary focus-visible:ring-ring grid size-10 place-items-center rounded-full border transition-colors focus-visible:ring-2 focus-visible:outline-none disabled:pointer-events-none disabled:opacity-40';
// Templates the script fills in per slide; {n} and {total} survive translation.
const templates = {
  slide: t('a11y.slideLabel', { n: '{n}', total: '{total}' }),
  status: t('a11y.slideStatus', { n: '{n}', total: '{total}' }),
  marker: t('a11y.goToSlide', { n: '{n}' }),
};
---

<section
  class={cn('flex flex-col gap-4', className)}
  aria-roledescription="carousel"
  aria-label={label}
  data-carousel
  data-label-slide={templates.slide}
  data-label-status={templates.status}
  data-label-marker={templates.marker}
>
  {
    !hideControls && (
      <div class="flex items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-1" role="group" aria-label={t('a11y.slides')} data-carousel-markers />
        <div class="order-last flex gap-2">
          <button type="button" class={button} aria-label={t('a11y.previous')} data-carousel-prev>
            <Icon name="chevron-left" size="md" />
          </button>
          <button type="button" class={button} aria-label={t('a11y.next')} data-carousel-next>
            <Icon name="chevron-right" size="md" />
          </button>
        </div>
      </div>
    )
  }
  <div
    class={cn(
      'relative grid snap-x snap-mandatory grid-flow-col gap-6 overflow-x-auto overscroll-x-contain scroll-smooth pb-2 motion-reduce:scroll-auto',
      '[&>*]:snap-start',
      // The buttons and markers show that it scrolls; without them, keep a thin scrollbar as the cue.
      hideControls ? '[scrollbar-width:thin]' : '[scrollbar-width:none] [&::-webkit-scrollbar]:hidden',
      columns[perView]
    )}
    tabindex="0"
    data-carousel-track
  >
    <slot />
  </div>
  <p class="sr-only" aria-live="polite" aria-atomic="true" data-carousel-status></p>
</section>

<style>
  /* Markers: a 24px target around an 8px dot; the current one is wider, so it
     doesn't rely on colour alone. */
  [data-carousel-markers] :global(button) {
    display: grid;
    place-items: center;
    width: 1.5rem;
    height: 1.5rem;
    border-radius: 9999px;
  }
  [data-carousel-markers] :global(button)::before {
    content: '';
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: var(--color-foreground-subtle);
    transition: width 150ms ease-out, background-color 150ms ease-out;
  }
  [data-carousel-markers] :global(button[aria-current='true'])::before {
    width: 1.25rem;
    background: var(--color-foreground);
  }
  [data-carousel-markers] :global(button:focus-visible) {
    outline: 2px solid var(--color-ring);
    outline-offset: 0;
  }

</style>

<script>
  const fill = (template: string, values: Record<string, number>) =>
    template.replace(/\{(\w+)\}/g, (_, key: string) => String(values[key] ?? ''));

  function initCarousels() {
    document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((carousel) => {
      if (carousel.dataset.carouselInit) return;
      const found = carousel.querySelector<HTMLElement>('[data-carousel-track]');
      if (!found) return;
      const track: HTMLElement = found;
      carousel.dataset.carouselInit = 'true';

      const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
      const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
      const markerGroup = carousel.querySelector<HTMLElement>('[data-carousel-markers]');
      const status = carousel.querySelector<HTMLElement>('[data-carousel-status]');
      const slides = Array.from(track.children).filter((el): el is HTMLElement => el instanceof HTMLElement);
      const total = slides.length;
      const { labelSlide = '{n} / {total}', labelStatus = '{n} / {total}', labelMarker = '{n}' } = carousel.dataset;

      slides.forEach((slide, i) => {
        // A slide that is itself a link or button keeps its own role and name;
        // role="group" would hide them from assistive technology.
        if (slide.matches('a[href], button, [role]')) return;
        slide.setAttribute('role', 'group');
        slide.setAttribute('aria-roledescription', 'slide');
        if (!slide.hasAttribute('aria-label')) slide.setAttribute('aria-label', fill(labelSlide, { n: i + 1, total }));
      });

      const maxScroll = () => track.scrollWidth - track.clientWidth;
      // Where each slide snaps to, clamped to the end of the track. With several
      // slides in view the last few share the final position.
      const snapLeft = (slide: HTMLElement) => Math.min(slide.offsetLeft, maxScroll()); // track is the offsetParent
      // Slides that have a distinct snap position (the ones a marker can reach).
      const stops = () => {
        const seen = new Set<number>();
        return slides.filter((slide) => {
          const left = Math.round(snapLeft(slide));
          if (seen.has(left)) return false;
          seen.add(left);
          return true;
        });
      };
      const nearest = (list = stops()) => {
        let best = 0;
        list.forEach((slide, i) => {
          if (Math.abs(snapLeft(slide) - track.scrollLeft) < Math.abs(snapLeft(list[best]) - track.scrollLeft)) best = i;
        });
        return best;
      };

      let pending: number | null = null;
      let settled = -1;
      let markers: HTMLButtonElement[] = [];

      const scrollToStop = (index: number) => {
        const list = stops();
        const i = Math.max(0, Math.min(list.length - 1, index));
        pending = i;
        setCurrent(i);
        track.scrollBy({ left: snapLeft(list[i]) - track.scrollLeft });
      };

      function setCurrent(i: number) {
        markers.forEach((m, n) => (n === i ? m.setAttribute('aria-current', 'true') : m.removeAttribute('aria-current')));
      }

      function buildMarkers() {
        if (!markerGroup) return;
        const list = stops();
        markerGroup.replaceChildren();
        markers = list.length > 1 ? list.map((slide, i) => {
          const marker = document.createElement('button');
          marker.type = 'button';
          marker.setAttribute('aria-label', fill(labelMarker, { n: slides.indexOf(slide) + 1 }));
          marker.addEventListener('click', () => scrollToStop(i));
          markerGroup.append(marker);
          return marker;
        }) : [];
        setCurrent(nearest(list));
      }

      function settle() {
        const list = stops();
        const i = nearest(list);
        pending = null;
        setCurrent(i);
        const atStart = track.scrollLeft <= 1;
        const atEnd = track.scrollLeft >= maxScroll() - 1;
        // Don't strand focus on a button that is about to be disabled.
        if (prev && atStart && document.activeElement === prev) next?.focus();
        if (next && atEnd && document.activeElement === next) prev?.focus();
        if (prev) prev.disabled = atStart;
        if (next) next.disabled = atEnd;
        if (settled !== -1 && i !== settled && status) {
          status.textContent = fill(labelStatus, { n: slides.indexOf(list[i]) + 1, total });
        }
        settled = i;
      }

      prev?.addEventListener('click', () => scrollToStop((pending ?? nearest()) - 1));
      next?.addEventListener('click', () => scrollToStop((pending ?? nearest()) + 1));

      // Keep the markers in step while scrolling, at most once per frame.
      let frame = 0;
      track.addEventListener(
        'scroll',
        () => {
          if (pending !== null || frame) return;
          frame = requestAnimationFrame(() => {
            frame = 0;
            setCurrent(nearest());
          });
        },
        { passive: true }
      );

      if ('onscrollend' in window) {
        track.addEventListener('scrollend', settle);
      } else {
        let timer: ReturnType<typeof setTimeout>;
        track.addEventListener('scroll', () => {
          clearTimeout(timer);
          timer = setTimeout(settle, 120);
        }, { passive: true });
      }

      new ResizeObserver(() => {
        buildMarkers();
        settle();
      }).observe(track);
    });
  }

  initCarousels();
  document.addEventListener('astro:after-swap', initCarousels);
</script>
