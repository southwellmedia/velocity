---
/**
 * A row of customer or partner logos under a short label. Logos are images:
 * an imported file (optimised by Astro) or a path in public/. They are muted
 * until hovered, and each logo's `name` is its alt text.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { cn } from '@/lib/cn';
import Band from './Band.astro';
import type { BandTone } from './band.variants';

interface Logo {
  name: string;
  src: ImageMetadata | string;
  href?: string;
}

interface Props {
  logos: Logo[];
  /** A short line above the logos, e.g. "Trusted by teams at" */
  label?: string;
  tone?: BandTone;
  /** Show logos in full colour instead of muted grey */
  color?: boolean;
  id?: string;
  class?: string;
}

const { logos, label, tone = 'default', color = false, id, class: className } = Astro.props;
const logoClass = cn(
  'h-8 w-auto max-w-[9rem] object-contain transition-[filter,opacity] duration-200',
  !color && 'opacity-60 grayscale hover:opacity-100 hover:grayscale-0'
);
---

<Band id={id} tone={tone} pad="sm" class={className}>
  {label && <p class="text-foreground-muted mb-8 text-center text-sm font-medium">{label}</p>}
  <ul class="flex flex-wrap items-center justify-center gap-x-12 gap-y-8">
    {
      logos.map((logo) => {
        const img =
          typeof logo.src === 'string' ? (
            <img src={logo.src} alt={logo.name} class={logoClass} loading="lazy" decoding="async" />
          ) : (
            <Image src={logo.src} alt={logo.name} class={logoClass} height={64} />
          );
        return <li>{logo.href ? <a href={logo.href}>{img}</a> : img}</li>;
      })
    }
  </ul>
</Band>
