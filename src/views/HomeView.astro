---
/**
 * Home view — the demo landing page.
 * Rendered by src/pages/index.astro (default locale) and
 * src/pages/[lang]/index.astro (other locales).
 *
 * Every figure on the page is read or measured at build time (see
 * src/components/landing/receipt.ts and integrations/build-receipt.mjs),
 * so it is true wherever the demo is deployed.
 */
import LandingLayout from '@/layouts/LandingLayout.astro';
import { Hero } from '@/components/hero';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import NpmCopyButton from '@/components/ui/marketing/NpmCopyButton/NpmCopyButton.astro';
import BuildReceipt from '@/components/landing/BuildReceipt.astro';
import WhatsNew from '@/components/landing/WhatsNew.astro';
import SpecimenWall from '@/components/landing/SpecimenWall.astro';
import GetStarted from '@/components/landing/GetStarted.astro';
import { getReceipt } from '@/components/landing/receipt';
import { useTranslations, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const receipt = getReceipt();
---

<LandingLayout title={t('meta.home.title')} description={t('meta.home.description')}>
  <Hero layout="centered" size="lg" showGrid>
    <Badge slot="badge" pill>
      {receipt.velocity
        ? t('home.hero.badge', { version: receipt.velocity, date: receipt.builtOn })
        : t('home.hero.badgeNoVersion', { date: receipt.builtOn })}
    </Badge>

    <h1 slot="title" class="max-w-4xl">
      {t('home.hero.title')} <span class="hero-highlight">{t('home.hero.titleHighlight')}</span>{t('home.hero.titleEnd')}
    </h1>

    <p slot="description">
      {t('home.hero.leadBefore')} <code class="bg-secondary text-foreground-secondary rounded px-1.5 py-0.5 font-mono text-[0.875em]">--demo</code> {t('home.hero.leadAfter')}
    </p>

    <Fragment slot="actions">
      <NpmCopyButton copiedText={t('home.hero.copied')} class="max-sm:px-4 max-sm:text-sm" />
      <Button size="lg" variant="secondary" href="#features" trailingIcon="arrow-right">
        {t('home.hero.whatsNew')}
      </Button>
    </Fragment>
  </Hero>

  <BuildReceipt receipt={receipt} />
  <WhatsNew skills={receipt.agentSkills} />
  <SpecimenWall count={receipt.components} />
  <GetStarted />
</LandingLayout>

<style>
  /* The one use of the brand color on the first screen */
  .hero-highlight {
    /* --brand-ink passes AA on --brand-fill */
    background: var(--color-brand-fill);
    color: var(--color-brand-ink);
    padding: 0 0.18em;
    border-radius: 6px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }
</style>
