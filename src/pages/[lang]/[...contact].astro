---
/**
 * Contact page for non-default locales (e.g. /es/…).
 * Generates nothing while only one locale is enabled in src/i18n/locales.mjs.
 */
import ContactView from '@/views/ContactView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export function getStaticPaths() {
  return getLocalizedStaticPaths('contact', 'contact');
}

const { locale } = Astro.props as { locale: Locale };
---

<ContactView locale={locale} />
