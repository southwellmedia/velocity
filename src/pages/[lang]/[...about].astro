---
/**
 * About page for non-default locales (e.g. /es/…).
 * Generates nothing while only one locale is enabled in src/i18n/locales.mjs.
 */
import AboutView from '@/views/AboutView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export function getStaticPaths() {
  return getLocalizedStaticPaths('about', 'about');
}

const { locale } = Astro.props as { locale: Locale };
---

<AboutView locale={locale} />
