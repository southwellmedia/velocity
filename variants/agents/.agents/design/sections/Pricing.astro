---
/* @velocity-section Pricing@2.5.0
 * Plans side by side (2 to 4), or a single offer.
 * Only prices the user supplied. Otherwise pass [[placeholder: price]] and list it in the handoff.
 * @requires section, card, badge, button, icon
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import Section from '@/components/patterns/Section.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Badge from '@/components/ui/data-display/Badge/Badge.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { cn } from '@/lib/cn';

interface Tier {
  name: string;
  price: string;
  /** Such as "per month", already translated */
  period?: string;
  description?: string;
  features: string[];
  cta: { label: string; href: string };
  featured?: boolean;
  /** Label on the featured plan, such as "Most popular" */
  badge?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  tiers: Tier[];
  tone?: 'default' | 'secondary';
  class?: string;
}

const { id, eyebrow, title, lead, tiers, tone = 'default', class: className } = Astro.props;
const columns = { 1: 'max-w-md mx-auto', 2: 'md:grid-cols-2 max-w-4xl mx-auto', 3: 'md:grid-cols-3', 4: 'md:grid-cols-2 lg:grid-cols-4' }[Math.min(tiers.length, 4)];
---

<Section id={id} eyebrow={eyebrow} title={title} lead={lead} tone={tone} class={className}>
  <div class={cn('grid gap-6', columns)}>
    {tiers.map((tier) => (
      <Card variant={tier.featured ? 'elevated' : 'default'} padding="lg" class={cn('flex h-full flex-col', tier.featured && 'border-primary border-2')}>
        <div class="flex items-center justify-between gap-3">
          <h3 class="font-display text-foreground text-xl font-semibold">{tier.name}</h3>
          {tier.featured && tier.badge && <Badge variant="brand" size="sm" pill>{tier.badge}</Badge>}
        </div>
        {tier.description && <p class="text-foreground-muted mt-2 text-sm">{tier.description}</p>}
        <p class="mt-6 flex items-baseline gap-2">
          <span class="font-display text-foreground text-4xl font-bold tracking-tight">{tier.price}</span>
          {tier.period && <span class="text-foreground-muted text-sm">{tier.period}</span>}
        </p>
        <ul class="mt-6 flex-1 space-y-3">
          {tier.features.map((feature) => (
            <li class="text-foreground-secondary flex gap-3 text-sm">
              <Icon name="check" size="sm" class="text-accent-hover mt-0.5 shrink-0" />
              <span>{feature}</span>
            </li>
          ))}
        </ul>
        <Button href={tier.cta.href} variant={tier.featured ? 'primary' : 'outline'} fullWidth class="mt-8">{tier.cta.label}</Button>
      </Card>
    ))}
  </div>
</Section>
