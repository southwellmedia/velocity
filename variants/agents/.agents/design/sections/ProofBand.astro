---
/* @velocity-section ProofBand@2.5.0
 * A narrow band of evidence right after the hero: figures, or customer faces with one line.
 * Real data only. If the user hasn't given figures or customers, leave this section out:
 * a placeholder statistic reads as an invented one.
 * @requires avatar-group
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import AvatarGroup from '@/components/ui/data-display/AvatarGroup/AvatarGroup.astro';
import { cn } from '@/lib/cn';

interface Stat {
  value: string;
  label: string;
}

interface Person {
  src?: string;
  alt: string;
}

interface Props {
  layout?: 'stats' | 'avatars';
  stats?: Stat[];
  people?: Person[];
  /** The line next to the faces, such as who they are */
  text?: string;
  tone?: 'default' | 'secondary';
  class?: string;
}

const { layout = 'stats', stats = [], people = [], text, tone = 'secondary', class: className } = Astro.props;
---

<section class={cn('border-border border-y py-10', tone === 'secondary' && 'bg-background-secondary', className)}>
  <div class="mx-auto max-w-6xl px-6">
    {layout === 'stats' ? (
      <dl class="grid grid-cols-2 gap-8 md:grid-cols-4">
        {stats.map((stat) => (
          <div class="flex flex-col">
            <dt class="text-foreground-muted order-2 mt-1 text-sm">{stat.label}</dt>
            <dd class="font-display text-foreground order-1 text-3xl font-bold tracking-tight">{stat.value}</dd>
          </div>
        ))}
      </dl>
    ) : (
      <div class="flex flex-col items-center justify-center gap-4 text-center sm:flex-row sm:text-left">
        <AvatarGroup avatars={people} max={5} size="md" />
        {text && <p class="text-foreground-secondary">{text}</p>}
      </div>
    )}
  </div>
</section>
