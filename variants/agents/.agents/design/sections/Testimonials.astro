---
/* @velocity-section Testimonials@2.6.0
 * What customers say: a grid of quotes, one large quote, or a wall of short quotes in columns.
 * @changed 2.6.0: 'wall' layout
 * Only real quotes the user supplied. Otherwise pass [[placeholder: …]] text and list it in the handoff.
 * @requires section, card, avatar
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import Section from '@/components/patterns/Section.astro';
import Card from '@/components/ui/data-display/Card/Card.astro';
import Avatar from '@/components/ui/data-display/Avatar/Avatar.astro';
import { cn } from '@/lib/cn';

interface Quote {
  quote: string;
  name: string;
  role?: string;
  /** Image URL for the avatar; initials are shown without one */
  avatar?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  items: Quote[];
  layout?: 'grid' | 'single' | 'wall';
  tone?: 'default' | 'secondary';
  class?: string;
}

const { id, eyebrow, title, lead, items, layout = 'grid', tone = 'secondary', class: className } = Astro.props;
const [first] = items;
---

<Section id={id} eyebrow={eyebrow} title={title} lead={lead} tone={tone} class={className}>
  {layout === 'wall' ? (
    <div class="gap-6 sm:columns-2 lg:columns-3">
      {items.map((item) => (
        <figure class="border-border mb-6 break-inside-avoid border-l-2 pl-5">
          <blockquote class="text-foreground">
            <p>{item.quote}</p>
          </blockquote>
          <figcaption class="text-foreground-muted mt-3 text-sm">
            <span class="text-foreground font-semibold">{item.name}</span>{item.role && <span>, {item.role}</span>}
          </figcaption>
        </figure>
      ))}
    </div>
  ) : layout === 'single' && first ? (
    <figure class="mx-auto max-w-3xl text-center">
      <blockquote class="font-display text-foreground text-3xl leading-snug text-balance">
        <p>{first.quote}</p>
      </blockquote>
      <figcaption class="mt-8 flex items-center justify-center gap-4">
        <Avatar src={first.avatar} alt={first.name} size="lg" />
        <span class="text-left">
          <span class="text-foreground block font-semibold">{first.name}</span>
          {first.role && <span class="text-foreground-muted block text-sm">{first.role}</span>}
        </span>
      </figcaption>
    </figure>
  ) : (
    <div class={cn('grid gap-6 md:grid-cols-2', items.length > 2 && 'lg:grid-cols-3')}>
      {items.map((item) => (
        <Card padding="lg" class="h-full">
          <figure class="flex h-full flex-col">
            <blockquote class="text-foreground flex-1 text-lg">
              <p>{item.quote}</p>
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <Avatar src={item.avatar} alt={item.name} size="md" />
              <span>
                <span class="text-foreground block text-sm font-semibold">{item.name}</span>
                {item.role && <span class="text-foreground-muted block text-sm">{item.role}</span>}
              </span>
            </figcaption>
          </figure>
        </Card>
      ))}
    </div>
  )}
</Section>
