---
/* @velocity-section HoursAndLocation@2.5.0
 * Opening hours and where to find the business, as a card beside the address or inline.
 * Only hours and an address the user supplied; otherwise pass [[placeholder: …]] and list them in the handoff.
 * Column labels come from the page's translations.
 * @requires section, table, icon
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import Section from '@/components/patterns/Section.astro';
import Table from '@/components/ui/data-display/Table/Table.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { cn } from '@/lib/cn';

interface Hours {
  day: string;
  time: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  hours: Hours[];
  /** Translated column headings, such as { day: 'Day', time: 'Open' } */
  columns: { day: string; time: string };
  /** Address lines, already formatted for the locale */
  address?: string[];
  addressLabel?: string;
  /** Link to directions, such as a maps URL */
  directions?: { label: string; href: string };
  phone?: { label: string; value: string; href: string };
  layout?: 'card' | 'inline';
  tone?: 'default' | 'secondary';
  class?: string;
}

const { id, eyebrow, title, lead, hours, columns, address = [], addressLabel, directions, phone, layout = 'card', tone = 'default', class: className } = Astro.props;
const rows = hours.map((h) => ({ day: h.day, time: h.time }));
---

<Section id={id} eyebrow={eyebrow} title={title} lead={lead} tone={tone} class={className}>
  <div class={cn('grid gap-10', layout === 'card' ? 'md:grid-cols-2' : 'lg:grid-cols-3')}>
    <Table
      columns={[{ key: 'day', label: columns.day }, { key: 'time', label: columns.time, align: 'right' }]}
      rows={rows}
      hoverable={false}
      class={cn(layout === 'inline' && 'lg:col-span-2')}
    />
    {(address.length > 0 || phone) && (
      <div class={cn(layout === 'card' && 'bg-card border-card-border rounded-xl border p-6 md:p-8')}>
        {address.length > 0 && (
          <div class="flex gap-4">
            <Icon name="map-pin" size="md" class="text-accent-hover mt-1 shrink-0" />
            <div>
              {addressLabel && <h3 class="font-display text-foreground font-semibold">{addressLabel}</h3>}
              <address class="text-foreground-secondary mt-1 not-italic">
                {address.map((line) => <span class="block">{line}</span>)}
              </address>
              {directions && <a href={directions.href} class="text-foreground mt-3 inline-flex items-center gap-1 text-sm font-medium underline-offset-4 hover:underline">{directions.label}<Icon name="arrow-up-right" size="xs" /></a>}
            </div>
          </div>
        )}
        {phone && (
          <div class={cn('flex gap-4', address.length > 0 && 'mt-6')}>
            <Icon name="phone" size="md" class="text-accent-hover mt-1 shrink-0" />
            <div>
              <h3 class="font-display text-foreground font-semibold">{phone.label}</h3>
              <a href={phone.href} class="text-foreground-secondary mt-1 block underline-offset-4 hover:underline">{phone.value}</a>
            </div>
          </div>
        )}
      </div>
    )}
  </div>
</Section>
