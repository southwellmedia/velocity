---
/* @velocity-section Team@2.5.0
 * The people: a grid with portraits, or a compact list.
 * Only people the user named. Missing portraits show labelled placeholders, listed in the handoff.
 * @requires section, media-slot, avatar
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import Section from '@/components/patterns/Section.astro';
import MediaSlot from '@/components/patterns/MediaSlot.astro';
import Avatar from '@/components/ui/data-display/Avatar/Avatar.astro';
import { cn } from '@/lib/cn';

interface Member {
  name: string;
  role: string;
  bio?: string;
  /** File name in src/assets/photos/ (grid) */
  photo?: string;
  /** Image URL (list); initials are shown without one */
  avatar?: string;
}

interface Props {
  id?: string;
  eyebrow?: string;
  title?: string;
  lead?: string;
  members: Member[];
  layout?: 'grid' | 'list';
  tone?: 'default' | 'secondary';
  class?: string;
}

const { id, eyebrow, title, lead, members, layout = 'grid', tone = 'default', class: className } = Astro.props;
---

<Section id={id} eyebrow={eyebrow} title={title} lead={lead} tone={tone} class={className}>
  {layout === 'grid' ? (
    <ul class={cn('grid gap-8 sm:grid-cols-2', members.length > 2 && 'lg:grid-cols-3', members.length > 3 && 'xl:grid-cols-4')}>
      {members.map((member) => (
        <li>
          <MediaSlot photo={member.photo} alt={member.name} label={member.name} ratio="4/5" icon="users" class="rounded-lg" />
          <h3 class="font-display text-foreground mt-4 text-lg font-semibold">{member.name}</h3>
          <p class="text-foreground-muted text-sm">{member.role}</p>
          {member.bio && <p class="text-foreground-secondary mt-2 text-sm">{member.bio}</p>}
        </li>
      ))}
    </ul>
  ) : (
    <ul class="divide-border max-w-3xl divide-y">
      {members.map((member) => (
        <li class="flex gap-5 py-6 first:pt-0">
          <Avatar src={member.avatar} alt={member.name} size="lg" class="shrink-0" />
          <div>
            <h3 class="font-display text-foreground font-semibold">{member.name}</h3>
            <p class="text-foreground-muted text-sm">{member.role}</p>
            {member.bio && <p class="text-foreground-secondary mt-2">{member.bio}</p>}
          </div>
        </li>
      ))}
    </ul>
  )}
</Section>
