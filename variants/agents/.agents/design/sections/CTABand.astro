---
/* @velocity-section CTABand@2.5.0
 * The closing ask: a full-width contrast band, or an inline panel inside the page.
 * One primary action, the same one as the header CTA. At most two invert bands per page.
 * @requires cta, button
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import CTA from '@/components/ui/marketing/CTA/CTA.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import { cn } from '@/lib/cn';

interface Action {
  label: string;
  href: string;
}

interface Props {
  title: string;
  text?: string;
  primary: Action;
  secondary?: Action;
  layout?: 'invert' | 'inline';
  class?: string;
}

const { title, text, primary, secondary, layout = 'invert', class: className } = Astro.props;
---

{layout === 'invert' ? (
  <CTA variant="invert" size="lg" class={className}>
    <h2 slot="heading">{title}</h2>
    {text && <p slot="description">{text}</p>}
    <Fragment slot="actions">
      <Button href={primary.href} size="lg" trailingIcon="arrow-right">{primary.label}</Button>
      {secondary && <Button href={secondary.href} size="lg" variant="outline">{secondary.label}</Button>}
    </Fragment>
  </CTA>
) : (
  <section class={cn('py-[var(--space-section-sm)]', className)}>
    <div class="mx-auto max-w-6xl px-6">
      <div class="bg-background-secondary border-border flex flex-col gap-6 rounded-xl border p-8 md:flex-row md:items-center md:justify-between md:p-10">
        <div class="max-w-2xl">
          <h2 class="font-display text-foreground text-2xl font-semibold tracking-tight">{title}</h2>
          {text && <p class="text-foreground-secondary mt-2">{text}</p>}
        </div>
        <div class="flex shrink-0 flex-wrap gap-3">
          <Button href={primary.href} size="lg">{primary.label}</Button>
          {secondary && <Button href={secondary.href} size="lg" variant="ghost">{secondary.label}</Button>}
        </div>
      </div>
    </div>
  </section>
)}
