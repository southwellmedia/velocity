---
/* @velocity-section LogoCloud@2.5.0
 * Client, partner or press logos in a row or grid.
 * Real logos the user supplied only; never placeholders or invented clients. Leave it out otherwise.
 * Import each logo (import acme from '@/assets/logos/acme.svg') and pass it with its company name.
 * @requires none
 * Copy into src/components/sections/ and adapt. Rules: .agents/design.md
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { cn } from '@/lib/cn';

interface Logo {
  src: ImageMetadata;
  /** The company's name */
  alt: string;
}

interface Props {
  /** A short line above the logos, such as who trusts the business */
  text?: string;
  logos: Logo[];
  layout?: 'row' | 'grid';
  class?: string;
}

const { text, logos, layout = 'row', class: className } = Astro.props;
---

<section class={cn('py-[var(--space-section-sm)]', className)}>
  <div class="mx-auto max-w-6xl px-6">
    {text && <p class="text-foreground-muted mb-8 text-center text-sm font-medium">{text}</p>}
    <ul class={cn('items-center', layout === 'row' ? 'flex flex-wrap justify-center gap-x-12 gap-y-8' : 'grid grid-cols-2 gap-8 sm:grid-cols-3 lg:grid-cols-6')}>
      {logos.map((logo) => (
        <li class="flex justify-center">
          <Image src={logo.src} alt={logo.alt} class="h-8 w-auto opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0 dark:invert" />
        </li>
      ))}
    </ul>
  </div>
</section>
