{
  "id": "minimal-portfolio",
  "name": "Minimal portfolio",
  "feel": "Quiet, image-led",
  "suits": "designers, photographers, freelancers",
  "rhythm": "typographic hero → work grid with media → short about → inline CTA",
  "imagery": "The work is the design: large images, consistent ratios, no decoration",
  "brand": {
    "hue": 0,
    "chroma": 0.0
  },
  "neutral": {
    "hue": 0,
    "chroma": 0
  },
  "primary": "neutral",
  "invert": "neutral",
  "fonts": {
    "display": {
      "family": "DM Sans",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "body": {
      "family": "DM Sans",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "installedFallback": {
      "display": {
        "family": "Outfit",
        "fallbacks": [
          "sans-serif"
        ]
      },
      "body": {
        "family": "Manrope",
        "fallbacks": [
          "sans-serif"
        ]
      }
    }
  },
  "controls": {
    "--theme-heading-weight": "500",
    "--theme-heading-tracking": "-0.02em",
    "--theme-body-leading": "1.6",
    "--theme-heading-scale": "1",
    "--theme-display-scale": "1.1",
    "--theme-section-space": "1.25",
    "--theme-radius-sm": "0",
    "--theme-radius-md": "0",
    "--theme-radius-lg": "0",
    "--theme-radius-xl": "0",
    "--theme-radius-button": "0",
    "--theme-button-weight": "500",
    "--theme-shadow-sm": "none",
    "--theme-shadow-md": "none",
    "--theme-shadow-lg": "none",
    "--theme-shadow-xl": "none"
  },
  "variation": {
    "brandHue": 180,
    "chromaAbsolute": [
      0,
      0.35
    ],
    "neutralChromaAbsolute": [
      0,
      0.008
    ],
    "radius": [
      1
    ],
    "buttonRadius": [
      "0",
      "9999px"
    ],
    "headingWeight": [
      "400",
      "500",
      "600"
    ],
    "sectionSpace": [
      0.95,
      1.1
    ]
  },
  "fontPairs": [
    {
      "display": "Geist",
      "body": "Geist",
      "note": "technical, precise"
    },
    {
      "display": "Hanken Grotesk",
      "body": "Hanken Grotesk",
      "note": "warmer grotesque"
    }
  ]
}
