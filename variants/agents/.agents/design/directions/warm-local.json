    "chroma": 0.014
  },
  "primary": "brand",
  "invert": "brand",
  "fonts": {
    "display": {
      "family": "Nunito",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "body": {
      "family": "Nunito",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "installedFallback": {
      "display": {
        "family": "Outfit",
        "fallbacks": [
          "sans-serif"
        ]
      },
      "body": {
        "family": "Manrope",
        "fallbacks": [
          "sans-serif"
        ]
      }
    }
  },
  "controls": {
