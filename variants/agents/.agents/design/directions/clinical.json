{
  "id": "clinical",
  "name": "Clinical",
  "feel": "Trustworthy, clear",
  "suits": "clinics, legal, finance",
  "rhythm": "centred hero → proof band → 3-column services → steps → FAQ → contact band",
  "imagery": "Calm, well-lit photos of people and spaces; never stock handshakes",
  "brand": {
    "hue": 230,
    "chroma": 0.7
  },
  "neutral": {
    "chroma": 0.008
  },
  "primary": "brand",
  "invert": "neutral",
  "fonts": {
    "display": {
      "family": "Figtree",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "body": {
      "family": "Figtree",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "installedFallback": {
      "display": {
        "family": "Outfit",
        "fallbacks": [
          "sans-serif"
        ]
      },
      "body": {
        "family": "Manrope",
        "fallbacks": [
          "sans-serif"
        ]
      }
    }
  },
  "controls": {
    "--theme-heading-weight": "600",
    "--theme-heading-tracking": "-0.015em",
    "--theme-body-leading": "1.7",
    "--theme-heading-scale": "0.95",
    "--theme-display-scale": "0.9",
    "--theme-section-space": "1.2",
    "--theme-radius-sm": "0.375rem",
    "--theme-radius-md": "0.5rem",
    "--theme-radius-lg": "0.75rem",
    "--theme-radius-xl": "1rem",
    "--theme-radius-button": "0.5rem",
    "--theme-button-weight": "600",
    "--theme-shadow-sm": "0 1px 2px rgba(0, 20, 40, 0.05)",
    "--theme-shadow-md": "0 4px 10px rgba(0, 20, 40, 0.06)",
    "--theme-shadow-lg": "0 8px 20px rgba(0, 20, 40, 0.08)",
    "--theme-shadow-xl": "0 20px 40px rgba(0, 20, 40, 0.1)"
  }
}
