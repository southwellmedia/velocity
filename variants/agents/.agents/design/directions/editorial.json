{
  "id": "editorial",
  "name": "Editorial",
  "feel": "Calm, type-led",
  "suits": "agencies, consultants, writers",
  "rhythm": "typographic hero → long-form intro → list with media → quote → inline CTA",
  "imagery": "Few, large images with generous captions; a typographic hero works without photos",
  "brand": {
    "hue": 25,
    "chroma": 0.75
  },
  "neutral": {
    "chroma": 0.006
  },
  "primary": "neutral",
  "invert": "neutral",
  "fonts": {
    "display": {
      "family": "Fraunces",
      "fallbacks": [
        "serif"
      ]
    },
    "body": {
      "family": "Source Sans 3",
      "fallbacks": [
        "sans-serif"
      ]
    },
    "installedFallback": {
      "display": {
        "family": "Outfit",
        "fallbacks": [
          "sans-serif"
        ]
      },
      "body": {
        "family": "Manrope",
        "fallbacks": [
          "sans-serif"
        ]
      }
    }
  },
  "controls": {
    "--theme-heading-weight": "500",
    "--theme-heading-tracking": "-0.01em",
    "--theme-body-leading": "1.7",
    "--theme-heading-scale": "1.05",
    "--theme-display-scale": "1.05",
    "--theme-section-space": "1.15",
    "--theme-radius-sm": "0.125rem",
    "--theme-radius-md": "0.1875rem",
    "--theme-radius-lg": "0.25rem",
    "--theme-radius-xl": "0.375rem",
    "--theme-radius-button": "0.125rem",
    "--theme-button-weight": "500",
    "--theme-shadow-sm": "none",
    "--theme-shadow-md": "0 1px 0 rgba(0, 0, 0, 0.06)",
    "--theme-shadow-lg": "0 2px 6px rgba(0, 0, 0, 0.06)",
    "--theme-shadow-xl": "0 12px 32px rgba(0, 0, 0, 0.08)"
  }
}
