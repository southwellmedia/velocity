---
// Test fixture, not a scaffold overlay. `pnpm test:scaffold --only=sections` copies every
// section source from .agents/design/sections/ into src/components/sections/ of a fresh
// project, adds this page as src/pages/fixture/ (with the two hero pages beside it), and requires astro check, the build
// and check:agent (no design/* or hardcoded-text findings in the sections) to pass.
// velocity-allow-hardcoded velocity-single-language
import LandingLayout from '@/layouts/LandingLayout.astro';
import logo from '@/assets/branding/logomark.svg';
import HeroSplit from '@/components/sections/HeroSplit.astro';
import ProofBand from '@/components/sections/ProofBand.astro';
import FeatureGrid from '@/components/sections/FeatureGrid.astro';
import Steps from '@/components/sections/Steps.astro';
import Testimonials from '@/components/sections/Testimonials.astro';
import Pricing from '@/components/sections/Pricing.astro';
import FAQ from '@/components/sections/FAQ.astro';
import Team from '@/components/sections/Team.astro';
import ContactBand from '@/components/sections/ContactBand.astro';
import LogoCloud from '@/components/sections/LogoCloud.astro';
import CTABand from '@/components/sections/CTABand.astro';
import HoursAndLocation from '@/components/sections/HoursAndLocation.astro';

const action = { label: 'Book a visit', href: '/fixture/hero-centered/' };
const more = { label: 'See the menu', href: '#menu' };
const features = [
  { title: 'Sourdough daily', text: 'Baked before dawn with flour from a mill down the road.', icon: 'heart' },
  { title: 'Cakes to order', text: 'Birthday, wedding or just because. Two days notice.', icon: 'calendar' },
  { title: 'Coffee bar', text: 'Single-origin espresso and a long table by the window.', icon: 'star' },
];
---

<LandingLayout title="Section fixture" description="Every Velocity section source, rendered for tests.">
  <HeroSplit eyebrow="Leith, since 1987" title="Bread worth getting up early for" lead="A neighbourhood bakery with a wood-fired oven." primary={action} secondary={more} mediaLabel="The shop front" />
  <ProofBand stats={[{ value: '37', label: 'years baking' }, { value: '12', label: 'breads daily' }, { value: '4', label: 'bakers' }, { value: '1', label: 'oven' }]} />
  <FeatureGrid id="menu" eyebrow="What we make" title="From the oven" items={features} />
  <HoursAndLocation title="Opening hours" tone="secondary" hours={[{ day: 'Monday to Friday', time: '7:00 to 17:00' }, { day: 'Saturday', time: '8:00 to 15:00' }]} columns={{ day: 'Day', time: 'Open' }} address={['12 Example Street', 'Leith']} addressLabel="Find us" phone={{ label: 'Call', value: '[[placeholder: phone number]]', href: 'tel:' }} />
  <FeatureGrid title="Bento layout" layout="bento" items={[...features, features[0]]} />
  <FeatureGrid title="List layout" layout="list" tone="secondary" items={features} />
  <Steps title="How ordering works" items={[{ title: 'Pick a cake', text: 'Choose from the menu.' }, { title: 'Tell us the date', text: 'Two days notice.' }, { title: 'Collect it', text: 'Fresh that morning.' }]} />
  <Steps title="Vertical steps" layout="vertical" tone="secondary" items={[{ title: 'Order', text: 'Online or in the shop.' }, { title: 'Collect', text: 'Any time we are open.' }]} />
  <Testimonials title="What neighbours say" items={[{ quote: '[[placeholder: a customer quote]]', name: '[[placeholder: customer name]]' }, { quote: 'The best rye in town.', name: 'A regular', role: 'Leith' }, { quote: 'Worth the queue.', name: 'Another regular' }]} />
  <Testimonials layout="single" tone="default" items={[{ quote: 'They baked our wedding cake and it was perfect.', name: 'A happy couple' }]} />
  <Pricing title="Bread club" tiers={[{ name: 'Weekly', price: '[[placeholder: price]]', period: 'per week', features: ['One loaf', 'Pick any day'], cta: action }, { name: 'Family', price: '[[placeholder: price]]', period: 'per week', features: ['Three loaves', 'A cake a month'], cta: action, featured: true, badge: 'Most popular' }]} />
  <FAQ title="Questions" items={[{ question: 'Do you deliver?', answer: 'Not yet. Collection only.' }, { question: 'Gluten free?', answer: 'Two breads each Saturday.' }]} />
  <FAQ title="Split FAQ" layout="split" tone="secondary" items={[{ question: 'Can I order online?', answer: 'Yes, from the contact page.' }]} />
  <Team title="The bakers" members={[{ name: 'Rosa', role: 'Founder' }, { name: '[[placeholder: baker name]]', role: 'Baker' }, { name: 'Sam', role: 'Pastry' }]} />
  <Team title="List team" layout="list" tone="secondary" members={[{ name: 'Rosa', role: 'Founder', bio: 'Started the bakery in 1987.' }]} />
  <ContactBand title="Get in touch" details={[{ icon: 'mail', label: 'Email', value: 'hello@rosas.example', href: 'mailto:hello@rosas.example' }, { icon: 'map-pin', label: 'Address', value: '12 Example Street, Leith' }]} />
  <LogoCloud text="Stocked by" logos={[{ src: logo, alt: 'Velocity' }]} />
  <CTABand layout="inline" title="Hungry yet?" text="Come by before the sourdough sells out." primary={action} />
  <CTABand title="Order a cake" text="Two days notice is all we need." primary={action} secondary={more} />
</LandingLayout>
