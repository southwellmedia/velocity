{
  "name": "velocity",
  "version": "2.3.0",
  "description": "Southwell Astro Boilerplate - A production-ready starter template built on Astro 7 and Tailwind CSS v4",
  "type": "module",
  "author": "Southwell Media",
  "license": "MIT",
  "keywords": [
    "astro",
    "astro-theme",
    "theme",
    "tailwind",
    "tailwindcss",
    "typescript",
    "blog",
    "starter",
    "boilerplate",
    "seo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/southwellmedia/velocity"
  },
  "homepage": "https://github.com/southwellmedia/velocity#readme",
  "bugs": {
    "url": "https://github.com/southwellmedia/velocity/issues"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:bg": "astro dev --background",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "validate": "eslint . && astro check && vitest run && astro build && node scripts/check-agent.mjs",
    "check:agent": "node scripts/check-agent.mjs",
    "test:scaffold": "node scripts/scaffold-matrix.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:components": "node scripts/generate-components-ref.mjs --check",
    "generate:components": "node scripts/generate-components-ref.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.2",
    "@astrojs/netlify": "8.2.11",
    "@astrojs/node": "11.1.9",
    "@astrojs/react": "7.1.2",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "11.0.18",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "astro": "7.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "schema-dts": "^2.1.0",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@10.28.2"
}
