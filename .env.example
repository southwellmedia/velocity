# =============================================================================
# Velocity - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# Variables prefixed with PUBLIC_ are exposed to the browser - NEVER prefix secrets

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Your production site URL (used for sitemap, canonical URLs, OG images)
SITE_URL=https://example.com

# -----------------------------------------------------------------------------
# Deployment (optional)
# -----------------------------------------------------------------------------

# Adapter used for on-demand routes (Astro Actions). Auto-detected on Vercel,
# Netlify and Cloudflare; defaults to the Node standalone server elsewhere.
# Cloudflare requires: pnpm add @astrojs/cloudflare
# DEPLOY_TARGET=node            # node | vercel | netlify | cloudflare

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------

# Google Analytics 4 Measurement ID
# PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager Container ID
# PUBLIC_GTM_ID=GTM-XXXXXXX

# -----------------------------------------------------------------------------
# Form Handling (optional)
# -----------------------------------------------------------------------------

# Without these, form submissions are discarded and the server logs a warning.
# To use a provider SDK instead (Resend, Postmark, Mailchimp...), edit
# src/actions/index.ts.

# Contact form: each submission is POSTed here as JSON
# { name, email, subject, message }. A non-2xx response shows the form's error.
# CONTACT_FORM_ENDPOINT=https://api.example.com/contact

# Newsletter form: each signup is POSTed here as JSON { email }.
# NEWSLETTER_ENDPOINT=https://api.example.com/subscribe

# Optional: sent as "Authorization: Bearer <key>" with newsletter requests.
# NEWSLETTER_API_KEY=your-api-key

# Recommended in production: when a form has no delivery configured, show the
# form's error instead of telling the visitor their message was sent.
# FORMS_REQUIRE_DELIVERY=true

# -----------------------------------------------------------------------------
# Search Engine Verification (optional)
# -----------------------------------------------------------------------------

# Google Search Console verification code
# GOOGLE_SITE_VERIFICATION=your-verification-code

# Bing Webmaster Tools verification code
# BING_SITE_VERIFICATION=your-verification-code

# -----------------------------------------------------------------------------
# Consent / Privacy (optional)
# -----------------------------------------------------------------------------

# Enable the cookie consent banner (requires analytics to be configured)
# PUBLIC_CONSENT_ENABLED=true

# Link to your privacy policy page (shown in consent banner when set)
# PUBLIC_PRIVACY_POLICY_URL=/privacy
